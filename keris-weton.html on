<script>
// ===== DATA =====
const HARI_NEPTU = {0:{nama:'Minggu',neptu:5},1:{nama:'Senin',neptu:4},2:{nama:'Selasa',neptu:3},3:{nama:'Rabu',neptu:7},4:{nama:'Kamis',neptu:8},5:{nama:'Jumat',neptu:6},6:{nama:'Sabtu',neptu:9}};
const PASARAN = [{nama:'Legi',neptu:5},{nama:'Pahing',neptu:9},{nama:'Pon',neptu:7},{nama:'Wage',neptu:4},{nama:'Kliwon',neptu:8}];

const KERIS_DB = [
  {range:[7,9],nama:'Tilam Upih',jenis:'Keris Luk 3 — Tangguh Majapahit',pamor:'Wos Wutah',maknaPamor:'Beras Tumpah — lambang kemakmuran dan kecukupan sandang pangan',khasiat:['Ketenangan Jiwa','Rumah Tangga Harmonis','Perlindungan Keluarga','Ketenteraman Batin'],perawatan:'Rendam dalam air bunga setaman setiap malam Jumat Kliwon, simpan di tempat bersih dan harum.',pesan_jawa:'Siro iku cahya kang padhang, kang bisa madhangi peteng ing sekitarmu.',pesan_indo:'Engkau adalah cahaya yang terang, yang mampu menerangi kegelapan di sekitarmu.',color:'#3A7A6B',luk:3},
  {range:[10,12],nama:'Sabuk Inten',jenis:'Keris Luk 5 — Tangguh Tuban',pamor:'Adeg-adeg',maknaPamor:'Berdiri Tegak — lambang kewibawaan dan keteguhan pendirian',khasiat:['Kewibawaan Tinggi','Kepemimpinan','Disegani Banyak Orang','Karier Cemerlang'],perawatan:'Gosok dengan minyak cendana setiap bulan purnama, bungkus dengan kain beludru hitam.',pesan_jawa:'Siro bakal dadi ratu ing atasing uripmu dhewe, yen siro wani ngadeg kanthi jejeg.',pesan_indo:'Engkau akan menjadi raja atas hidupmu sendiri, jika engkau berani berdiri dengan tegak.',color:'#8B5A10',luk:5},
  {range:[13,15],nama:'Sengkelat',jenis:'Keris Luk 13 — Tangguh Demak',pamor:'Beras Wutah',maknaPamor:'Padi Berlimpah — lambang rezeki yang mengalir tanpa henti dari segala penjuru',khasiat:['Rezeki Melimpah','Usaha Lancar','Dijauhkan dari Kemiskinan','Berkah Berlipat'],perawatan:'Warangan setiap 2 tahun sekali, simpan menghadap kiblat di tempat yang tidak terkena sinar matahari langsung.',pesan_jawa:'Rejekimu kaya banyu ing segara, ora bakal sat selawase urip yen siro tansah eling lan syukur.',pesan_indo:'Rezekim adalah seperti air di samudra, tidak akan pernah kering selama hidupmu jika engkau selalu ingat dan bersyukur.',color:'#1A4A8A',luk:13},
  {range:[16,17],nama:'Condong Campur',jenis:'Keris Luk 7 — Tangguh Singasari',pamor:'Kulit Semangka',maknaPamor:'Pelindung Sejati — lapisan yang kuat melindungi isi dari gangguan luar',khasiat:['Perlindungan Gaib','Menolak Sihir','Keselamatan dari Bahaya','Aura Kuat'],perawatan:'Bacakan doa keselamatan setiap malam, simpan di rumah dengan dupa cendana.',pesan_jawa:'Siro direksa dening kekuatan kang ora katon, dadi aja wedi ngadhepi cobaan opo wae.',pesan_indo:'Engkau dilindungi oleh kekuatan yang tidak terlihat, maka jangan takut menghadapi cobaan apapun.',color:'#5A1A7A',luk:7},
  {range:[18,18],nama:'Jangkung Mayang',jenis:'Keris Luk 9 — Tangguh Pajajaran',pamor:'Sekar Jagad',maknaPamor:'Bunga Semesta — lambang keharmonisan dengan alam dan semesta raya',khasiat:['Keselamatan Perjalanan','Keberuntungan','Disukai Banyak Orang','Harmonis dengan Alam'],perawatan:'Setiap purnama letakkan di bawah cahaya bulan semalaman, bungkus dengan daun pandan wangi.',pesan_jawa:'Lakumu ing donya iki kaya angin kang bebas, nanging tansah bali marang asale.',pesan_indo:'Perjalananmu di dunia ini bagaikan angin yang bebas, namun selalu kembali pada asalnya.',color:'#1A6B3A',luk:9},
  {range:[19,20],nama:'Brojol',jenis:'Keris Lurus — Tangguh Mataram',pamor:'Ron Pakis',maknaPamor:'Daun Pakis Mengurai — lambang kemudahan dalam segala urusan dan kelancaran hidup',khasiat:['Kemudahan Urusan','Lancar Berbicara','Sukses dalam Negosiasi','Dijauhkan dari Musuh'],perawatan:'Bersihkan dengan bunga kenanga setiap Kamis malam, simpan berdiri tegak.',pesan_jawa:'Saben urusanmu bakal dadi gampang, kaya banyu kang mili saka gunung marang segara.',pesan_indo:'Setiap urusanmu akan menjadi mudah, bagaikan air yang mengalir dari gunung menuju samudra.',color:'#7A5A10',luk:0},
  {range:[21,22],nama:'Kyai Setan Kober',jenis:'Keris Luk 11 — Tangguh Pajang',pamor:'Ngulit Semangka',maknaPamor:'Pelapis Baja — kekuatan tanpa kompromi dalam menghadapi rintangan hidup',khasiat:['Keberanian Luar Biasa','Tidak Gentar Musuh','Kemenangan dalam Persaingan','Jiwa Ksatria'],perawatan:'Mandikan dengan air mawar setiap malam Selasa Kliwon, letakkan di altar khusus.',pesan_jawa:'Nyalimu kuwat kaya wesi, ora ana sing bisa ngalahake yen siro wis mbukak tekadmu.',pesan_indo:'Keberanianmu sekuat besi, tidak ada yang bisa mengalahkanmu jika engkau telah membuka tekadmu.',color:'#7A1A1A',luk:11},
  {range:[23,25],nama:'Bethok',jenis:'Keris Lurus Pendek — Tangguh Blambangan',pamor:'Putri Kinurung',maknaPamor:'Putri Terlindungi — kelembutan yang mengandung kekuatan tersembunyi di dalamnya',khasiat:['Kasih Sayang Tulus','Memikat Hati','Hubungan Asmara Lancar','Pesona Alami'],perawatan:'Simpan bersama bunga melati segar, ganti setiap Senin dan Kamis malam.',pesan_jawa:'Atinmu kang tulus iku kaya permata kang ora ternilai ing antarane bebatuan.',pesan_indo:'Hatimu yang tulus itu bagaikan permata yang tak ternilai di antara bebatuan.',color:'#7A1A5A',luk:0},
  {range:[26,30],nama:'Kyai Nagasasra',jenis:'Keris Luk 13 — Tangguh Mataram Sultan Agung',pamor:'Naga Siluman',maknaPamor:'Naga Gaib — kekuatan kosmis tertinggi yang bersumber dari langit dan bumi',khasiat:['Kekuatan Gaib Tertinggi','Derajat Mulia','Menguasai Ilmu Tinggi','Penjaga Pusaka'],perawatan:'Hanya boleh dibuka oleh yang empunya, dimandikan setahun sekali di malam 1 Suro dengan air tujuh sumber.',pesan_jawa:'Siro iku titising para leluhur kang mulia, gawa pusaka iki kanthi tanggung jawab kang agung.',pesan_indo:'Engkau adalah titisan para leluhur yang mulia, bawa pusaka ini dengan tanggung jawab yang agung.',color:'#1A1A7A',luk:13}
];

// ===== STATE =====
let currentStep = 0;
let selectedPayment = 'DANA';
let userName = '';
let wetonInfo = null;
let kerisResult = null;

// ===== UTILS =====
function getPasaran(dateStr) {
  const d = new Date(dateStr);
  const ref = new Date(2000, 0, 1);
  const diff = Math.floor((d - ref) / 86400000);
  return PASARAN[((diff % 5) + 5) % 5];
}

function getKeris(total) {
  return KERIS_DB.find(k => total >= k.range[0] && total <= k.range[1]) || KERIS_DB[KERIS_DB.length - 1];
}

function showToast(msg) {
  const t = document.getElementById('toastEl');
  t.textContent = msg;
  t.classList.remove('hidden');
  setTimeout(() => t.classList.add('hidden'), 2500);
}

function showLoading(text) {
  document.getElementById('loadingText').textContent = text;
  document.getElementById('loadingOverlay').classList.remove('hidden');
}

function hideLoading() {
  document.getElementById('loadingOverlay').classList.add('hidden');
}

function setStep(n) {
  [0,1,2].forEach(i => {
    document.getElementById('step'+i).classList.toggle('hidden', i !== n);
    const dot = document.getElementById('dot'+i);
    dot.classList.toggle('active', i === n);
    dot.classList.toggle('done', i < n);
  });
  currentStep = n;
  window.scrollTo({top:0, behavior:'smooth'});
}

// ===== PAYMENT =====
function selectPayment(method) {
  selectedPayment = method;
  document.getElementById('payDANA').classList.toggle('active', method === 'DANA');
  document.getElementById('payOVO').classList.toggle('active', method === 'OVO');
}

function handleFile(e) {
  const f = e.target.files[0];
  if (!f) return;
  document.getElementById('fileUploadArea').classList.add('hidden');
  document.getElementById('uploadedPreview').classList.remove('hidden');
  document.getElementById('uploadedName').textContent = f.name + ' — Siap dikirim';
}

function handlePayment() {
  const nama = document.getElementById('inputNama').value.trim();
  const hasFile = !document.getElementById('uploadedPreview').classList.contains('hidden');
  if (!nama) return showToast('Masukkan nama Anda terlebih dahulu');
  if (!hasFile) return showToast('Upload bukti transfer terlebih dahulu');
  userName = nama;
  showLoading('Membuka pintu pusaka...');
  setTimeout(() => {
    hideLoading();
    document.getElementById('greetNama').textContent = userName;
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('inputTanggal').max = today;
    setStep(1);
  }, 2600);
}

// ===== WETON =====
function hitungWeton() {
  const val = document.getElementById('inputTanggal').value;
  if (!val) return;
  const d = new Date(val);
  const hari = HARI_NEPTU[d.getDay()];
  const pasaran = getPasaran(val);
  const total = hari.neptu + pasaran.neptu;
  document.getElementById('rHariNeptu').textContent = hari.neptu;
  document.getElementById('rHariNama').textContent = hari.nama;
  document.getElementById('rPasaranNeptu').textContent = pasaran.neptu;
  document.getElementById('rPasaranNama').textContent = pasaran.nama;
  document.getElementById('rTotalNeptu').textContent = total;
  document.getElementById('rWetonFull').textContent = hari.nama + ' ' + pasaran.nama;
  document.getElementById('rNeptuSub').textContent = 'NEPTU ' + hari.neptu + ' + ' + pasaran.neptu + ' = ' + total;
  document.getElementById('wetonResult').classList.remove('hidden');
  wetonInfo = {hari, pasaran, total};
}

function handleWeton() {
  if (!document.getElementById('inputTanggal').value) return showToast('Pilih tanggal lahir Anda');
  if (!wetonInfo) return showToast('Pilih tanggal lahir Anda');
  showLoading('Membaca wangsit pusaka...');
  setTimeout(() => {
    kerisResult = getKeris(wetonInfo.total);
    renderResult();
    hideLoading();
    setStep(2);
  }, 3200);
}

// ===== RENDER RESULT =====
function buildKerisSVG(color, luk) {
  const w = 90, h = 250, cx = w / 2;
  let bladePath = '';
  if (luk === 0) {
    bladePath = `<path d="M${cx},10 L${cx-5},28 L${cx-4},${h-64} L${cx},${h-62} L${cx+4},${h-64} L${cx+5},28 Z" fill="url(#blade)" filter="url(#glow)"/>`;
  } else {
    const segs = Math.min(luk, 9);
    const segH = (h - 82) / segs;
    const amp = 7;
    let fwd = `M${cx},12 `;
    for (let i = 0; i < segs; i++) {
      const y2 = 12 + (i + 1) * segH;
      const off = (i % 2 === 0 ? 1 : -1) * amp;
      fwd += `Q${cx + off * 2},${12 + i * segH + segH * 0.5} ${cx + off},${y2} `;
    }
    fwd += `L${cx},${h-65} `;
    let bwd = `L${cx-3},${h-65} `;
    for (let i = segs - 1; i >= 0; i--) {
      const y1 = 12 + i * segH;
      const off = (i % 2 === 0 ? 1 : -1) * (-amp);
      bwd += `Q${cx + off * 2},${y1 + segH * 0.5 + 3} ${cx + off - 2},${y1 + 3} `;
    }
    bwd += `L${cx-3},14 Z`;
    bladePath = `<path d="${fwd}${bwd}" fill="url(#blade)" filter="url(#glow)"/>`;
  }
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="blade" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E8C97A"/>
      <stop offset="40%" stop-color="${color}"/>
      <stop offset="100%" stop-color="#1A0D00"/>
    </linearGradient>
    <linearGradient id="hndl" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2A1608"/>
      <stop offset="50%" stop-color="#5A2E10"/>
      <stop offset="100%" stop-color="#2A1608"/>
    </linearGradient>
    <filter id="glow"><feGaussianBlur stdDeviation="2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
  </defs>
  <rect x="${cx-13}" y="${h-62}" width="26" height="7" rx="2" fill="url(#hndl)"/>
  <rect x="${cx-8}" y="${h-55}" width="16" height="46" rx="3" fill="url(#hndl)"/>
  <rect x="${cx-5}" y="${h-51}" width="10" height="38" rx="2" fill="rgba(201,168,76,0.13)"/>
  ${bladePath}
  <line x1="${cx-1}" y1="18" x2="${cx-1}" y2="${h-67}" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
  <ellipse cx="${cx}" cy="13" rx="3" ry="4" fill="#E8C97A" opacity="0.9"/>
  </svg>`;
}

function renderResult() {
  const k = kerisResult;
  const w = wetonInfo;
  document.getElementById('rNamaUser').textContent = userName;
  document.getElementById('rWetonSub').textContent = `Weton ${w.hari.nama} ${w.pasaran.nama} · Neptu ${w.total}`;
  document.getElementById('kerisSVGwrap').innerHTML = buildKerisSVG(k.color, k.luk);
  document.getElementById('rKerisNama').textContent = 'Keris ' + k.nama;
  document.getElementById('rKerisJenis').textContent = k.jenis;
  document.getElementById('rPamor').textContent = k.pamor;
  document.getElementById('rMaknaPamor').textContent = k.maknaPamor;
  const tags = document.getElementById('rKhasiat');
  tags.innerHTML = k.khasiat.map(x => `<span class="khasiat-tag">${x}</span>`).join('');
  document.getElementById('rPerawatan').textContent = k.perawatan;
  document.getElementById('rPesanJawa').textContent = '"' + k.pesan_jawa + '"';
  document.getElementById('rPesanIndo').textContent = '— ' + k.pesan_indo;
}

// ===== SHARE =====
function shareWA() {
  if (!kerisResult || !wetonInfo) return;
  const text = `✨ WETON SAYA BICARA ✨\n\n📅 Hari: ${wetonInfo.hari.nama} ${wetonInfo.pasaran.nama}\n🔢 Neptu: ${wetonInfo.total}\n\n⚔️ Keris Pusaka Saya: *${kerisResult.nama}*\n📿 Pamor: ${kerisResult.pamor}\n🌟 Khasiat: ${kerisResult.khasiat.join(', ')}\n\n🙏 "${kerisResult.pesan_indo}"\n\nCek keris pusaka sesuai wetonmu di:\nhttps://keris-weton.app`;
  window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank');
}
function shareTwitter() {
  if (!kerisResult) return;
  const text = `Keris pusaka saya berdasarkan weton adalah ${kerisResult.nama} dengan pamor ${kerisResult.pamor}! ✨⚔️ #WetonJawa #PusakaJawa #KerisWeton`;
  window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(text), '_blank');
}
function shareFB() {
  window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent('https://keris-weton.app'), '_blank');
}
function copyLink() {
  navigator.clipboard.writeText('https://keris-weton.app').then(() => showToast('Link berhasil disalin! ✓'));
}
function copyCard() {
  if (!kerisResult || !wetonInfo) return;
  const text = `⚔️ KERIS PUSAKA SAYA ⚔️\n\nNama: ${userName}\nWeton: ${wetonInfo.hari.nama} ${wetonInfo.pasaran.nama} (Neptu ${wetonInfo.total})\n\nKeris: ${kerisResult.nama}\nPamor: ${kerisResult.pamor}\n${kerisResult.maknaPamor}\n\nKhasiat: ${kerisResult.khasiat.join(' · ')}\n\n"${kerisResult.pesan_indo}"\n\n✦ keris-weton.app ✦`;
  navigator.clipboard.writeText(text).then(() => showToast('Teks kartu berhasil disalin! ✓'));
}
function resetWeton() {
  wetonInfo = null;
  document.getElementById('inputTanggal').value = '';
  document.getElementById('wetonResult').classList.add('hidden');
  setStep(1);
}
</script>
