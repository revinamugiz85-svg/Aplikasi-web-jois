@charset "utf-8";

:root { --gold: #C9A84C; --gold-light: #F0D080; --gold-dark: #8B6914; --deep: #0A0612; --purple-deep: #1A0A2E; --purple-mid: #2D1557; --purple-light: #4A2080; --crimson: #8B1A2E; --teal: #0D4A4A; --text: #E8D8B0; --text-dim: #A0887A; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { background: var(--deep); color: var(--text); font-family: "Crimson Pro", serif; min-height: 100vh; overflow-x: hidden; }

.stars { position: fixed; inset: 0px; z-index: 0; pointer-events: none; }

.stars::before, .stars::after { content: ""; position: absolute; inset: 0px; background-image: radial-gradient(1px 1px at 10% 15%, rgba(255, 255, 200, 0.8) 0%, transparent 100%), radial-gradient(1px 1px at 25% 40%, rgba(255, 255, 200, 0.6) 0%, transparent 100%), radial-gradient(1.5px 1.5px at 40% 20%, rgba(255, 255, 200, 0.9) 0%, transparent 100%), radial-gradient(1px 1px at 55% 60%, rgba(255, 255, 200, 0.5) 0%, transparent 100%), radial-gradient(1px 1px at 70% 30%, rgba(255, 255, 200, 0.7) 0%, transparent 100%), radial-gradient(1.5px 1.5px at 80% 70%, rgba(255, 255, 200, 0.8) 0%, transparent 100%), radial-gradient(1px 1px at 90% 10%, rgba(255, 255, 200, 0.6) 0%, transparent 100%), radial-gradient(1px 1px at 15% 80%, rgba(255, 255, 200, 0.7) 0%, transparent 100%), radial-gradient(1px 1px at 35% 90%, rgba(255, 255, 200, 0.5) 0%, transparent 100%), radial-gradient(1.5px 1.5px at 60% 85%, rgba(255, 255, 200, 0.8) 0%, transparent 100%), radial-gradient(1px 1px at 5% 50%, rgba(255, 255, 200, 0.6) 0%, transparent 100%), radial-gradient(1px 1px at 75% 50%, rgba(255, 255, 200, 0.7) 0%, transparent 100%), radial-gradient(1px 1px at 45% 5%, rgba(255, 255, 200, 0.9) 0%, transparent 100%), radial-gradient(1px 1px at 88% 45%, rgba(255, 255, 200, 0.5) 0%, transparent 100%), radial-gradient(1.5px 1.5px at 20% 60%, rgba(255, 255, 200, 0.8) 0%, transparent 100%); animation: 4s ease-in-out 0s infinite alternate none running twinkle; }

.stars::after { background-image: radial-gradient(1px 1px at 12% 35%, rgba(200, 200, 255, 0.6) 0%, transparent 100%), radial-gradient(1px 1px at 48% 75%, rgba(200, 200, 255, 0.5) 0%, transparent 100%), radial-gradient(1.5px 1.5px at 65% 15%, rgba(200, 200, 255, 0.7) 0%, transparent 100%), radial-gradient(1px 1px at 82% 88%, rgba(200, 200, 255, 0.6) 0%, transparent 100%), radial-gradient(1px 1px at 30% 55%, rgba(200, 200, 255, 0.5) 0%, transparent 100%), radial-gradient(1px 1px at 95% 25%, rgba(200, 200, 255, 0.8) 0%, transparent 100%), radial-gradient(1px 1px at 7% 95%, rgba(200, 200, 255, 0.6) 0%, transparent 100%); animation: 5s ease-in-out 0s infinite alternate-reverse none running twinkle; }

@keyframes twinkle { 
  0% { opacity: 0.4; }
  100% { opacity: 1; }
}

.screen { display: none; position: relative; z-index: 1; min-height: 100vh; padding: 20px; }

.screen.active { display: flex; flex-direction: column; align-items: center; }

#screen-landing { justify-content: center; text-align: center; background: radial-gradient(at 50% 0%, rgba(74, 32, 128, 0.4) 0%, transparent 70%), radial-gradient(at 50% 100%, rgba(139, 26, 46, 0.3) 0%, transparent 60%); }

.orb { width: 180px; height: 180px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(201, 168, 76, 0.4) 0%, rgba(74, 32, 128, 0.6) 40%, rgba(10, 6, 18, 0.9) 100%); border: 2px solid rgba(201, 168, 76, 0.5); box-shadow: rgba(201, 168, 76, 0.3) 0px 0px 40px, rgba(74, 32, 128, 0.4) 0px 0px 80px, rgba(201, 168, 76, 0.1) 0px 0px 40px inset; margin: 0px auto 30px; animation: 3s ease-in-out 0s infinite normal none running orbPulse; display: flex; align-items: center; justify-content: center; font-size: 70px; cursor: pointer; }

@keyframes orbPulse { 
  0%, 100% { box-shadow: rgba(201, 168, 76, 0.3) 0px 0px 40px, rgba(74, 32, 128, 0.4) 0px 0px 80px, rgba(201, 168, 76, 0.1) 0px 0px 40px inset; }
  50% { box-shadow: rgba(201, 168, 76, 0.5) 0px 0px 60px, rgba(74, 32, 128, 0.6) 0px 0px 120px, rgba(201, 168, 76, 0.2) 0px 0px 60px inset; }
}

.app-title { font-family: "Cinzel Decorative", serif; font-size: clamp(22px, 5vw, 38px); font-weight: 900; background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; -webkit-text-fill-color: transparent; background-clip: text; text-shadow: none; letter-spacing: 2px; margin-bottom: 8px; }

.app-subtitle { font-family: "Crimson Pro", serif; font-style: italic; font-size: 18px; color: var(--text-dim); margin-bottom: 40px; letter-spacing: 3px; }

.divider { width: 200px; height: 1px; background: linear-gradient(to right, transparent, var(--gold), transparent); margin: 20px auto; }

.feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; max-width: 400px; margin: 30px auto; }

.feature-card { background: rgba(45, 21, 87, 0.4); border: 1px solid rgba(201, 168, 76, 0.2); border-radius: 12px; padding: 16px 12px; text-align: center; backdrop-filter: blur(10px); }

.feature-card .icon { font-size: 28px; margin-bottom: 8px; display: block; }

.feature-card .name { font-family: "Cinzel Decorative", serif; font-size: 9px; color: var(--gold); letter-spacing: 1px; text-transform: uppercase; }

.topic-list { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 380px; margin: 20px auto; }

.topic-chip { background: rgba(139, 26, 46, 0.3); border: 1px solid rgba(201, 168, 76, 0.3); border-radius: 20px; padding: 6px 14px; font-size: 13px; color: var(--gold-light); }

.price-box { background: linear-gradient(135deg, rgba(45, 21, 87, 0.6), rgba(139, 26, 46, 0.3)); border: 1px solid var(--gold); border-radius: 16px; padding: 20px 30px; margin: 20px auto; max-width: 320px; text-align: center; }

.price-label { font-size: 13px; color: var(--text-dim); letter-spacing: 2px; text-transform: uppercase; }

.price-amount { font-family: "Cinzel Decorative", serif; font-size: 32px; color: var(--gold); margin: 5px 0px; }

.price-note { font-size: 12px; color: var(--text-dim); font-style: italic; }

.btn-primary { background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light)); color: var(--deep); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 50px; padding: 16px 50px; font-family: "Cinzel Decorative", serif; font-size: 14px; font-weight: 700; letter-spacing: 2px; cursor: pointer; margin: 10px auto; display: block; box-shadow: rgba(201, 168, 76, 0.4) 0px 4px 30px; transition: 0.3s; max-width: 300px; width: 100%; }

.btn-primary:hover { transform: translateY(-2px); box-shadow: rgba(201, 168, 76, 0.6) 0px 8px 40px; }

.disclaimer { font-size: 11px; color: var(--text-dim); font-style: italic; margin-top: 20px; opacity: 0.7; max-width: 320px; text-align: center; line-height: 1.6; }

#screen-payment { background: radial-gradient(at 30% 20%, rgba(13, 74, 74, 0.3) 0%, transparent 60%); justify-content: flex-start; padding-top: 30px; }

.back-btn { align-self: flex-start; background: none; border: 1px solid rgba(201, 168, 76, 0.3); color: var(--gold); border-radius: 8px; padding: 8px 16px; font-size: 13px; cursor: pointer; margin-bottom: 20px; font-family: "Crimson Pro", serif; }

.payment-title { font-family: "Cinzel Decorative", serif; font-size: 18px; color: var(--gold); text-align: center; margin-bottom: 6px; }

.payment-sub { text-align: center; color: var(--text-dim); font-size: 14px; margin-bottom: 25px; }

.payment-methods { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 380px; }

.method-card { background: rgba(45, 21, 87, 0.4); border: 2px solid rgba(201, 168, 76, 0.2); border-radius: 14px; padding: 18px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 14px; }

.method-card:hover, .method-card.selected { border-color: var(--gold); background: rgba(74, 32, 128, 0.5); box-shadow: rgba(201, 168, 76, 0.2) 0px 0px 20px; }

.method-logo { width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; flex-shrink: 0; }

.dana-logo { background: linear-gradient(135deg, rgb(16, 142, 233), rgb(0, 112, 204)); color: white; font-size: 14px; font-family: sans-serif; }

.ovo-logo { background: linear-gradient(135deg, rgb(76, 42, 134), rgb(123, 82, 171)); color: white; font-size: 12px; font-family: sans-serif; }

.qris-logo { background: linear-gradient(135deg, rgb(227, 30, 36), rgb(196, 16, 24)); color: white; font-size: 10px; font-family: sans-serif; }

.method-info { flex: 1 1 0%; }

.method-name { font-family: "Cinzel Decorative", serif; font-size: 13px; color: var(--gold); }

.method-desc { font-size: 12px; color: var(--text-dim); margin-top: 3px; }

.method-check { font-size: 20px; opacity: 0; transition: opacity 0.2s; }

.method-card.selected .method-check { opacity: 1; }

.payment-detail { display: none; width: 100%; max-width: 380px; margin-top: 20px; }

.payment-detail.show { display: block; }

.detail-box { background: rgba(10, 6, 18, 0.8); border: 1px solid rgba(201, 168, 76, 0.3); border-radius: 14px; padding: 20px; text-align: center; }

.detail-number { font-family: "Cinzel Decorative", serif; font-size: 22px; color: var(--gold); letter-spacing: 3px; margin: 10px 0px; }

.detail-name { font-size: 14px; color: var(--text-dim); }

.detail-amount { font-size: 28px; font-weight: 700; color: var(--gold-light); margin: 10px 0px; }

.copy-btn { background: rgba(201, 168, 76, 0.2); border: 1px solid var(--gold); color: var(--gold); border-radius: 8px; padding: 8px 20px; cursor: pointer; font-size: 12px; margin-top: 10px; transition: 0.2s; }

.copy-btn:hover { background: rgba(201, 168, 76, 0.4); }

.upload-area { margin-top: 16px; border: 2px dashed rgba(201, 168, 76, 0.4); border-radius: 14px; padding: 25px; text-align: center; cursor: pointer; transition: 0.3s; position: relative; }

.upload-area:hover { border-color: var(--gold); background: rgba(201, 168, 76, 0.05); }

.upload-area input { position: absolute; inset: 0px; opacity: 0; cursor: pointer; }

.upload-icon { font-size: 36px; margin-bottom: 10px; }

.upload-text { font-size: 13px; color: var(--text-dim); }

.upload-text strong { color: var(--gold); }

.upload-preview { display: none; margin-top: 12px; border-radius: 10px; overflow: hidden; max-height: 200px; }

.upload-preview img { width: 100%; object-fit: cover; }

.upload-preview.show { display: block; }

#screen-form { justify-content: flex-start; padding-top: 30px; background: radial-gradient(at 70% 30%, rgba(74, 32, 128, 0.3) 0%, transparent 60%); }

.form-title { font-family: "Cinzel Decorative", serif; font-size: 16px; color: var(--gold); text-align: center; margin-bottom: 5px; }

.form-sub { text-align: center; color: var(--text-dim); font-size: 14px; font-style: italic; margin-bottom: 25px; }

.form-group { width: 100%; max-width: 380px; margin-bottom: 16px; }

.form-label { display: block; font-size: 12px; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 6px; font-family: "Cinzel Decorative", serif; }

.form-input, .form-select { width: 100%; background: rgba(45, 21, 87, 0.4); border: 1px solid rgba(201, 168, 76, 0.3); border-radius: 10px; padding: 12px 16px; color: var(--text); font-family: "Crimson Pro", serif; font-size: 16px; outline: none; transition: border-color 0.2s; appearance: none; }

.form-input:focus, .form-select:focus { border-color: var(--gold); }

.form-select option { background: rgb(26, 10, 46); }

.topic-select-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; width: 100%; max-width: 380px; margin-bottom: 20px; }

.topic-btn { background: rgba(45, 21, 87, 0.4); border: 2px solid rgba(201, 168, 76, 0.2); border-radius: 12px; padding: 14px 10px; text-align: center; cursor: pointer; transition: 0.2s; color: var(--text); font-family: "Crimson Pro", serif; font-size: 14px; }

.topic-btn:hover, .topic-btn.selected { border-color: var(--gold); background: rgba(74, 32, 128, 0.5); }

.topic-btn .t-icon { font-size: 24px; display: block; margin-bottom: 5px; }

#screen-result { justify-content: flex-start; padding-top: 20px; background: radial-gradient(at 20% 10%, rgba(139, 26, 46, 0.3) 0%, transparent 50%), radial-gradient(at 80% 90%, rgba(74, 32, 128, 0.4) 0%, transparent 50%); }

.result-header { text-align: center; margin-bottom: 20px; width: 100%; max-width: 420px; }

.result-name { font-family: "Cinzel Decorative", serif; font-size: 20px; color: var(--gold); margin-bottom: 5px; }

.result-meta { font-size: 14px; color: var(--text-dim); font-style: italic; }

.result-card { width: 100%; max-width: 420px; background: linear-gradient(135deg, rgba(45, 21, 87, 0.7), rgba(10, 6, 18, 0.8)); border: 1px solid rgba(201, 168, 76, 0.3); border-radius: 18px; padding: 20px; margin-bottom: 16px; backdrop-filter: blur(10px); position: relative; overflow: hidden; }

.result-card::before { content: ""; position: absolute; top: 0px; left: 0px; right: 0px; height: 2px; background: linear-gradient(to right, transparent, var(--gold), transparent); }

.result-card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }

.result-source-icon { font-size: 28px; }

.result-source-name { font-family: "Cinzel Decorative", serif; font-size: 11px; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; }

.result-source-topic { font-size: 13px; color: var(--text-dim); font-style: italic; }

.result-text { font-size: 16px; line-height: 1.8; color: var(--text); font-style: italic; }

.luck-meter { margin-top: 12px; display: flex; align-items: center; gap: 10px; }

.luck-label { font-size: 12px; color: var(--text-dim); min-width: 80px; }

.luck-bar-bg { flex: 1 1 0%; height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 3px; overflow: hidden; }

.luck-bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(to right, var(--gold-dark), var(--gold), var(--gold-light)); transition: width 1.5s; }

.luck-value { font-size: 13px; color: var(--gold); font-weight: bold; min-width: 35px; text-align: right; }

.share-section { width: 100%; max-width: 420px; text-align: center; margin-top: 10px; margin-bottom: 40px; }

.share-title { font-family: "Cinzel Decorative", serif; font-size: 12px; color: var(--text-dim); letter-spacing: 2px; margin-bottom: 14px; }

.share-buttons { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

.share-btn { display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 50px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; font-size: 13px; font-family: "Crimson Pro", serif; font-weight: 600; transition: 0.2s; }

.share-btn:hover { transform: translateY(-2px); }

.share-wa { background: rgb(37, 211, 102); color: white; }

.share-ig { background: linear-gradient(135deg, rgb(245, 133, 41), rgb(221, 42, 123), rgb(81, 91, 212)); color: white; }

.share-copy-link { background: rgba(201, 168, 76, 0.2); color: var(--gold); border: 1px solid var(--gold); }

.new-reading-btn { background: transparent; border: 1px solid rgba(201, 168, 76, 0.4); color: var(--gold); border-radius: 50px; padding: 12px 30px; font-family: "Cinzel Decorative", serif; font-size: 11px; cursor: pointer; margin-top: 10px; letter-spacing: 1px; transition: 0.2s; }

.new-reading-btn:hover { background: rgba(201, 168, 76, 0.1); }

.loading-screen { display: none; position: fixed; inset: 0px; background: rgba(10, 6, 18, 0.95); z-index: 100; flex-direction: column; align-items: center; justify-content: center; text-align: center; }

.loading-screen.show { display: flex; }

.loading-orb { width: 100px; height: 100px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, rgba(201, 168, 76, 0.5), rgba(74, 32, 128, 0.8)); border: 2px solid var(--gold); animation: 2s linear 0s infinite normal none running spin; margin-bottom: 24px; display: flex; align-items: center; justify-content: center; font-size: 40px; }

@keyframes spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text { font-family: "Cinzel Decorative", serif; font-size: 14px; color: var(--gold); letter-spacing: 2px; margin-bottom: 10px; }

.loading-sub { font-size: 13px; color: var(--text-dim); font-style: italic; }

.loading-dots span { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); margin: 0px 4px; animation: 1.4s ease-in-out 0s infinite normal none running bounce; }

.loading-dots span:nth-child(2) { animation-delay: 0.2s; }

.loading-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce { 
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

.toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px); background: rgba(45, 21, 87, 0.95); border: 1px solid var(--gold); color: var(--text); padding: 12px 24px; border-radius: 50px; font-size: 14px; z-index: 200; transition: transform 0.3s; backdrop-filter: blur(10px); white-space: nowrap; }

.toast.show { transform: translateX(-50%) translateY(0px); }

@media (max-width: 400px) {
  .feature-grid { grid-template-columns: repeat(2, 1fr); }
  .topic-select-grid { grid-template-columns: repeat(2, 1fr); }
}

.glow-text { text-shadow: rgba(201, 168, 76, 0.5) 0px 0px 20px; }

.steps { display: flex; gap: 8px; align-items: center; margin-bottom: 20px; }

.step-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(201, 168, 76, 0.2); border: 1px solid rgba(201, 168, 76, 0.4); }

.step-dot.active { background: var(--gold); }

.verified-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(13, 74, 74, 0.4); border: 1px solid rgba(0, 200, 150, 0.4); border-radius: 20px; padding: 4px 12px; font-size: 11px; color: rgb(110, 255, 208); margin-top: 8px; }
