<!DOCTYPE html><html lang="id"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-060fe080-741e-4678-955c-3076784cc321@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🔮 Nusantara Mystic — Ramalan Nusantara</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&amp;family=Crimson+Pro:ital,wght@0,300;0,400;1,300;1,400&amp;family=Noto+Serif:wght@400;700&amp;display=swap" rel="stylesheet">

</head>
<body>

<div class="stars"></div>

<!-- LOADING -->
<div class="loading-screen" id="loadingScreen">
  <div class="loading-orb">🔮</div>
  <div class="loading-text">Membaca Takdir Anda</div>
  <div class="loading-sub">Menyelaraskan energi kosmik...</div>
  <br>
  <div class="loading-dots"><span></span><span></span><span></span></div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- ===== SCREEN 1: LANDING ===== -->
<div class="screen active" id="screen-landing">
  <div class="orb">🔮</div>

  <div class="app-title">Nusantara Mystic</div>
  <div class="app-subtitle">✦ Ramalan Warisan Leluhur ✦</div>

  <div class="divider"></div>

  <div class="feature-grid">
    <div class="feature-card">
      <span class="icon">☯️</span>
      <span class="name">Feng Shui</span>
    </div>
    <div class="feature-card">
      <span class="icon">⭐</span>
      <span class="name">Bintang &amp; Zodiak</span>
    </div>
    <div class="feature-card">
      <span class="icon">🃏</span>
      <span class="name">Kartu Tarot</span>
    </div>
    <div class="feature-card">
      <span class="icon">📜</span>
      <span class="name">Primbon Kuno</span>
    </div>
  </div>

  <div class="topic-list">
    <div class="topic-chip">💼 Karir &amp; Jabatan</div>
    <div class="topic-chip">🍀 Keberuntungan</div>
    <div class="topic-chip">⚠️ Musibah</div>
    <div class="topic-chip">💕 Percintaan</div>
  </div>

  <div class="divider"></div>

  <div class="price-box">
    <div class="price-label">Konsultasi Lengkap</div>
    <div class="price-amount">Rp 35.000</div>
    <div class="price-note">Ramalan 1 Minggu — 1 Bulan ke Depan</div>
    <div class="price-note">✓ 4 Sumber Kearifan ✓ Semua Topik</div>
  </div>

  <button class="btn-primary">
    ✨ MULAI RAMALAN ✨
  </button>

  <p class="disclaimer">
    ⚠️ <strong>Untuk Hiburan Semata.</strong> Ramalan ini bersifat hiburan dan tidak menggantikan saran profesional di bidang karir, medis, atau keuangan. Nikmati dengan bijak.
  </p>
</div>

<!-- ===== SCREEN 2: PAYMENT ===== -->
<div class="screen" id="screen-payment">
  <button class="back-btn">← Kembali</button>

  <div class="steps">
    <div class="step-dot active"></div>
    <div class="step-dot"></div>
    <div class="step-dot"></div>
  </div>

  <div class="payment-title">Pilih Metode Pembayaran</div>
  <div class="payment-sub">Total: <strong style="color:var(--gold)">Rp 35.000</strong></div>

  <div class="payment-methods">
    <div class="method-card">
      <div class="method-logo dana-logo">DANA</div>
      <div class="method-info">
        <div class="method-name">DANA</div>
        <div class="method-desc">Transfer ke nomor DANA</div>
      </div>
      <div class="method-check">✓</div>
    </div>

    <div class="method-card">
      <div class="method-logo ovo-logo">OVO</div>
      <div class="method-info">
        <div class="method-name">OVO</div>
        <div class="method-desc">Transfer ke nomor OVO</div>
      </div>
      <div class="method-check">✓</div>
    </div>

    <div class="method-card">
      <div class="method-logo qris-logo">QRIS</div>
      <div class="method-info">
        <div class="method-name">QRIS</div>
        <div class="method-desc">Scan kode QR — semua e-wallet</div>
      </div>
      <div class="method-check">✓</div>
    </div>
  </div>

  <!-- Detail pembayaran -->
  <div class="payment-detail" id="paymentDetail">
    <div class="detail-box" id="detailBox"></div>

    <div style="margin-top:16px; padding: 12px; background: rgba(201,168,76,0.08); border-radius: 12px; border: 1px dashed rgba(201,168,76,0.3);">
      <p style="font-size:13px; color:var(--text-dim); text-align:center; margin-bottom: 10px;">📸 Upload screenshot bukti pembayaran</p>
      <div class="upload-area">
        <input type="file" id="proofInput" accept="image/*">
        <div class="upload-icon">📷</div>
        <div class="upload-text">Tap untuk upload <strong>screenshot bukti transfer</strong></div>
      </div>
      <div class="upload-preview" id="uploadPreview">
        <img id="previewImg" src="https://ramalanmistikologi.netlify.app/" alt="Bukti Transfer">
        <div class="verified-badge">✓ Bukti terupload</div>
      </div>
    </div>

    <button class="btn-primary" id="verifyBtn" style="margin-top:16px; display:none;">
      ✨ VERIFIKASI &amp; LANJUT
    </button>
    <p style="font-size:11px; color:var(--text-dim); text-align:center; margin-top:8px; font-style:italic;">
      ⚠️ Untuk integrasi pembayaran otomatis, hubungkan dengan Midtrans/Xendit
    </p>
  </div>
</div>

<!-- ===== SCREEN 3: FORM ===== -->
<div class="screen" id="screen-form">
  <button class="back-btn">← Kembali</button>

  <div class="steps">
    <div class="step-dot"></div>
    <div class="step-dot active"></div>
    <div class="step-dot"></div>
  </div>

  <div class="form-title">Data Diri Anda</div>
  <div class="form-sub">Untuk keakuratan ramalan</div>

  <div class="form-group">
    <label class="form-label">Nama Lengkap</label>
    <input type="text" class="form-input" id="inputName" placeholder="Masukkan nama Anda...">
  </div>

  <div class="form-group">
    <label class="form-label">Tanggal Lahir</label>
    <input type="date" class="form-input" id="inputDob">
  </div>

  <div class="form-group">
    <label class="form-label">Jenis Kelamin</label>
    <select class="form-select" id="inputGender">
      <option value="">Pilih...</option>
      <option value="Pria">Pria</option>
      <option value="Wanita">Wanita</option>
    </select>
  </div>

  <label class="form-label" style="max-width:380px; width:100%; margin-bottom:10px;">Topik Ramalan</label>
  <div class="topic-select-grid">
    <div class="topic-btn">
      <span class="t-icon">💼</span>Karir &amp; Jabatan
    </div>
    <div class="topic-btn">
      <span class="t-icon">🍀</span>Keberuntungan
    </div>
    <div class="topic-btn">
      <span class="t-icon">⚠️</span>Musibah &amp; Bahaya
    </div>
    <div class="topic-btn">
      <span class="t-icon">💕</span>Percintaan
    </div>
  </div>

  <button class="btn-primary" style="margin-top:10px;">
    🔮 LIHAT RAMALAN SAYA
  </button>
</div>

<!-- ===== SCREEN 4: RESULT ===== -->
<div class="screen" id="screen-result">
  <div class="result-header">
    <div class="result-name" id="resultName">✦ Ramalan Anda ✦</div>
    <div class="result-meta" id="resultMeta"></div>
    <div class="divider" style="width:150px; margin:10px auto;"></div>
  </div>

  <div id="resultCards"></div>

  <div class="share-section">
    <div class="share-title">✦ BAGIKAN RAMALAN ANDA ✦</div>
    <div class="share-buttons">
      <button class="share-btn share-wa">
        💬 WhatsApp
      </button>
      <button class="share-btn share-ig">
        📷 Instagram
      </button>
      <button class="share-btn share-copy-link">
        🔗 Salin Link
      </button>
    </div>
    <br>
    <button class="new-reading-btn">
      ✦ RAMALAN BARU ✦
    </button>
  </div>
</div>




</body></html>
